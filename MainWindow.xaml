<Window x:Class="SharpEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sharpEngine="clr-namespace:Ab4d.SharpEngine.Wpf;assembly=Ab4d.SharpEngine.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SharpEngine"
        mc:Ignorable="d"
        Title="Facade Lighting Preview" Height="700" Width="1240" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#101014">

    <!-- Resources = things defined once and reused below, like colors and styles (a bit like a shared material in Unity) -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#15161B" />
        <SolidColorBrush x:Key="CardBrush" Color="#1E2027" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#262932" />
        <SolidColorBrush x:Key="LineBrush" Color="#2A2D36" />
        <SolidColorBrush x:Key="TextBrush" Color="#E6E7EB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8B8F9C" />
        <!-- the same yellow as the selection outlines in the 3D view -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FFE033" />

        <!-- small grey headings above each section -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- the little boxes that show a keyboard key, like "E" -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <!-- buttons: a rounded dark box that gets lighter under the mouse and fades out when disabled.
             a ControlTemplate replaces how a control looks, but keeps how it behaves -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the main action button gets the accent color -->
        <!-- small buttons for the facade size presets -->
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#15161B" />
        </Style>

        <!-- slider: a thin track, filled with the accent color up to a round handle -->
        <Style x:Key="SliderTrackPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!-- a transparent tall area so it's easy to click, with the thin visible track in the middle -->
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!-- PART_Track is the name WPF looks for to make the slider work -->
                        <Track x:Name="PART_Track" Height="22">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackPart}" Background="{StaticResource AccentBrush}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackPart}" Background="{StaticResource LineBrush}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="14" Height="14" Fill="White" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a thin dark scroll bar (no arrow buttons) for the panel, instead of the light Windows one -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <!-- IsDirectionReversed: for a vertical bar the top is the start -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3A3D48" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- dark text box for typing the text effect's text -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15161B" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <!-- PART_ContentHost is where WPF puts the actual editable text -->
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a "segmented" switch: radio buttons drawn as two halves of one box, the checked half lights up -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="{StaticResource LineBrush}" CornerRadius="6" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#15161B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- one row in the effect list: a rounded card, lighter under the mouse, accent bar on the left when chosen -->
        <Style x:Key="EffectItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{StaticResource CardBrush}" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="6,0,0,6" Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1" Margin="10,8" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- two columns: the 3D view takes all the space that's left (*), the panel on the right is 280 wide -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- column 0: the 3D view and everything drawn on top of it -->
        <Grid Grid.Column="0">
            <sharpEngine:SharpEngineSceneView x:Name="MainSceneView"
                                              BackgroundColor="#101014" />

            <!-- performance numbers in a small see-through card in the corner -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                    Background="#B015161B" CornerRadius="6" Padding="10,6" IsHitTestVisible="False">
                <TextBlock x:Name="StatsText" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12" />
            </Border>

            <!-- the box drawn while dragging to select. positioned with Margin, sized with Width / Height -->
            <Rectangle x:Name="SelectionBox" Visibility="Collapsed" IsHitTestVisible="False"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Fill="#22FFE033" Stroke="#FFFFE033" StrokeThickness="1" StrokeDashArray="4 3" />

            <!-- label that follows the mouse when hovering a fixture. IsHitTestVisible="False" so it never blocks the mouse -->
            <Border x:Name="HoverLabel" Visibility="Collapsed" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#E615161B" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1,0,0,0"
                    CornerRadius="4" Padding="10,6">
                <TextBlock x:Name="HoverText" Foreground="{StaticResource TextBrush}" FontSize="12" />
            </Border>

            <!-- shown in the middle of the view while a new facade is being built -->
            <Border x:Name="BuildingMessage" Visibility="Collapsed" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#E615161B" CornerRadius="8" Padding="20,12">
                <TextBlock Text="Building facade…" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- column 1: the control panel. ScrollViewer adds a scroll bar if the window gets too short -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer x:Name="PanelScrollViewer" VerticalScrollBarVisibility="Auto">
                <!-- a StackPanel puts its children under each other, top to bottom -->
                <StackPanel Margin="18,16">

                    <TextBlock Text="Facade Lighting" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="FacadeInfoText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,22" />

                    <!-- FACADE: change the size. presets build right away, custom numbers need Apply -->
                    <TextBlock Text="FACADE SIZE" Style="{StaticResource SectionHeader}" />
                    <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="Presets (total pixels)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" />
                            <!-- Tag holds "fixtures,pixels per fixture" for each preset, read in code -->
                            <UniformGrid Columns="5" Margin="-2,0">
                                <Button x:Name="Preset800" Content="800" Tag="100,8" Style="{StaticResource PresetButton}" ToolTip="100 fixtures × 8 pixels" />
                                <Button x:Name="Preset100K" Content="100K" Tag="1000,100" Style="{StaticResource PresetButton}" ToolTip="1,000 fixtures × 100 pixels" />
                                <Button x:Name="Preset1M" Content="1M" Tag="10000,100" Style="{StaticResource PresetButton}" ToolTip="10,000 fixtures × 100 pixels" />
                                <Button x:Name="Preset2M" Content="2M" Tag="20000,100" Style="{StaticResource PresetButton}" ToolTip="20,000 fixtures × 100 pixels" />
                                <Button x:Name="Preset5M" Content="5M" Tag="50000,100" Style="{StaticResource PresetButton}" ToolTip="50,000 fixtures × 100 pixels (the real-world target)" />
                            </UniformGrid>

                            <!-- custom size: label on the left, number box on the right -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Fixtures" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="FixtureCountBox" Grid.Row="0" Grid.Column="1" TextAlignment="Right" />
                                <TextBlock Grid.Row="2" Text="Pixels per fixture" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="PixelsPerFixtureBox" Grid.Row="2" Grid.Column="1" TextAlignment="Right" />
                            </Grid>

                            <TextBlock x:Name="FacadeTotalText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,10" />
                            <Button x:Name="ApplyFacadeButton" Content="Apply" Style="{StaticResource PrimaryButton}"
                                    ToolTip="Build a new facade with this size (Enter)" />
                        </StackPanel>
                    </Border>

                    <!-- EFFECT -->
                    <DockPanel Margin="0,0,0,0">
                        <Border Style="{StaticResource KeyCap}" DockPanel.Dock="Right" Margin="0,0,0,8">
                            <TextBlock Text="E" Style="{StaticResource KeyCapText}" />
                        </Border>
                        <TextBlock Text="EFFECT" Style="{StaticResource SectionHeader}" />
                    </DockPanel>
                    <!-- ItemTemplate = what one row shows: the effect's name, and its description under it -->
                    <ListBox x:Name="EffectList" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource EffectItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- settings for the Text effect. hidden unless the Text effect is chosen -->
                    <Border x:Name="TextSettings" Visibility="Collapsed" Background="{StaticResource CardBrush}"
                            CornerRadius="6" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="TEXT" Style="{StaticResource SectionHeader}" />
                            <TextBox x:Name="EffectTextBox" />
                            <TextBlock Text="Enter or Esc when done typing" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10" />
                            <!-- GroupName makes the two radio buttons belong together: checking one unchecks the other -->
                            <UniformGrid Columns="2" Margin="-2,0">
                                <RadioButton x:Name="TextStaticButton" Content="Static" GroupName="TextMode" IsChecked="True" Style="{StaticResource SegmentButton}" />
                                <RadioButton x:Name="TextScrollButton" Content="Scroll" GroupName="TextMode" Style="{StaticResource SegmentButton}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- settings for the Image effect. hidden unless the Image effect is chosen -->
                    <Border x:Name="ImageSettings" Visibility="Collapsed" Background="{StaticResource CardBrush}"
                            CornerRadius="6" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="IMAGE" Style="{StaticResource SectionHeader}" />
                            <Button x:Name="ChooseImageButton" Content="Choose image…" Style="{StaticResource PrimaryButton}" />
                            <TextBlock x:Name="ImageFileText" Text="No image chosen yet" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,10" />
                            <UniformGrid Columns="2" Margin="-2,0">
                                <RadioButton x:Name="ImageFitButton" Content="Fit" GroupName="ImageFit" IsChecked="True" Style="{StaticResource SegmentButton}"
                                             ToolTip="Show the whole picture" />
                                <RadioButton x:Name="ImageFillButton" Content="Fill" GroupName="ImageFit" Style="{StaticResource SegmentButton}"
                                             ToolTip="Cover the whole facade, crop the edges" />
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="-2,6,-2,0">
                                <RadioButton x:Name="ImageStaticButton" Content="Static" GroupName="ImageMode" IsChecked="True" Style="{StaticResource SegmentButton}" />
                                <RadioButton x:Name="ImageScrollButton" Content="Scroll" GroupName="ImageMode" Style="{StaticResource SegmentButton}"
                                             ToolTip="Move the picture across the facade (speed slider sets how fast)" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- settings for the Video effect. hidden unless the Video effect is chosen -->
                    <Border x:Name="VideoSettings" Visibility="Collapsed" Background="{StaticResource CardBrush}"
                            CornerRadius="6" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="VIDEO" Style="{StaticResource SectionHeader}" />
                            <UniformGrid Columns="2" Margin="-2,0">
                                <Button x:Name="ChooseVideoButton" Content="Choose video…" Style="{StaticResource PrimaryButton}" Margin="2,0" />
                                <Button x:Name="PlayPauseButton" Content="Pause" Margin="2,0" IsEnabled="False" />
                            </UniformGrid>
                            <TextBlock x:Name="VideoFileText" Text="No video chosen yet" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,2" />
                            <TextBlock Text="720p or 1080p videos work best. The speed slider sets the playback speed."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <UniformGrid Columns="2" Margin="-2,0">
                                <RadioButton x:Name="VideoFitButton" Content="Fit" GroupName="VideoFit" IsChecked="True" Style="{StaticResource SegmentButton}"
                                             ToolTip="Show the whole video" />
                                <RadioButton x:Name="VideoFillButton" Content="Fill" GroupName="VideoFit" Style="{StaticResource SegmentButton}"
                                             ToolTip="Cover the whole facade, crop the edges" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- SPEED. a DockPanel lets the value stick to the right side of the label row -->
                    <DockPanel Margin="0,18,0,0">
                        <TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" />
                        <TextBlock Text="SPEED" Style="{StaticResource SectionHeader}" Margin="0" />
                    </DockPanel>
                    <!-- IsSnapToTickEnabled makes the slider jump in steps of TickFrequency -->
                    <Slider x:Name="SpeedSlider" Minimum="0" Maximum="4" Value="1"
                            TickFrequency="0.25" IsSnapToTickEnabled="True" Margin="0,2,0,0" />

                    <!-- BRIGHTNESS -->
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" />
                        <TextBlock Text="BRIGHTNESS" Style="{StaticResource SectionHeader}" Margin="0" />
                    </DockPanel>
                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100"
                            TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,2,0,0" />

                    <!-- COLOR: a color wheel. colors the effect, or the selected fixtures when there are any -->
                    <TextBlock Text="COLOR" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                    <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <!-- tells you what the wheel is coloring right now -->
                            <TextBlock x:Name="ColorTargetText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- the wheel: a picture drawn in code, with a small ring on top that marks the picked color.
                                     a Canvas places its children at exact x / y positions -->
                                <Grid Grid.Column="0" Width="128" Height="128" Cursor="Cross">
                                    <Image x:Name="ColorWheelImage" />
                                    <Canvas IsHitTestVisible="False">
                                        <Ellipse x:Name="ColorWheelMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2" />
                                    </Canvas>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Border x:Name="ColorSwatch" Height="32" CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                                    <TextBlock x:Name="ColorHexText" Foreground="{StaticResource TextBrush}" FontFamily="Consolas"
                                               FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,12" />
                                    <Button x:Name="ClearPaintButton" Content="Clear painted" FontSize="11" Height="30"
                                            ToolTip="Remove the colors painted on fixtures" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SELECTION, in its own card -->
                    <TextBlock Text="SELECTION" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                    <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="SelectionText" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="SelectionDetailText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,12" TextWrapping="Wrap" />
                            <!-- UniformGrid with 2 columns makes both buttons the same width -->
                            <UniformGrid Columns="2">
                                <Button x:Name="IdentifyButton" Content="Identify" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"
                                        ToolTip="Make the selected fixtures blink (I)" />
                                <Button x:Name="ClearButton" Content="Clear" Margin="4,0,0,0"
                                        ToolTip="Clear the selection (Esc)" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- CONTROLS: what each input does, with the key shown as a small key cap -->
                    <TextBlock Text="CONTROLS" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <!-- every description text in this grid gets these settings -->
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B0B3BE" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="10,0,0,0" />
                            </Style>
                        </Grid.Resources>

                        <Border Grid.Row="0" Style="{StaticResource KeyCap}"><TextBlock Text="Left drag" Style="{StaticResource KeyCapText}" Margin="0" /></Border>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Box select" />

                        <Border Grid.Row="1" Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" Style="{StaticResource KeyCapText}" Margin="0" /></Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Add to selection" />

                        <Border Grid.Row="2" Style="{StaticResource KeyCap}"><TextBlock Text="Right drag" Style="{StaticResource KeyCapText}" Margin="0" /></Border>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Rotate camera" />

